guide_circles = [
    [0.000, 7.501, 8.000],
    [0.000, 71.913, 8.000]
];

module rounded_rect_2d(w, h, r) {
    offset(r = r)
        square([w - 2 * r, h - 2 * r], center = true);
}

module slot_2d(len, dia) {
    hull() {
        translate([-(len - dia) / 2, 0]) circle(d = dia);
        translate([(len - dia) / 2, 0]) circle(d = dia);
    }
}

module guide_rect_2d(w, h) {
    difference() {
        square([w + guide_width, h + guide_width], center = true);
        square([w - guide_width, h - guide_width], center = true);
    }
}

module guide_circle_2d(r) {
    difference() {
        circle(r = r + guide_width / 2);
        circle(r = r - guide_width / 2);
    }
}

module cutouts_2d() {
    for (h = circle_holes)
        translate([h[0], h[1]]) circle(r = h[2] + hole_extra);

    for (s = slot_holes)
        translate([s[0], s[1]])
            rotate(s[4])
                slot_2d(s[2] + 2 * hole_extra, s[3] + 2 * hole_extra);

    for (r = rounded_rect_holes)
        translate([r[0], r[1]])
            rounded_rect_2d(r[2] + 2 * hole_extra, r[3] + 2 * hole_extra, r[4] + hole_extra);
}

module reference_guides_2d() {
    for (g = guide_rects)
        translate([g[0], g[1]])
            guide_rect_2d(g[2], g[3]);

    for (c = guide_circles)
        translate([c[0], c[1]])
            guide_circle_2d(c[2]);
}

module r1_4wd_base_plate() {
    difference() {
        linear_extrude(plate_thickness)
            polygon(points = outline_points);

        translate([0, 0, -0.1])
            linear_extrude(plate_thickness + 0.2)
                cutouts_2d();

        if (show_reference_guides)
            translate([0, 0, plate_thickness - guide_depth])
                linear_extrude(guide_depth + 0.1)
                    reference_guides_2d();
    }
}

r1_4wd_base_plate();
